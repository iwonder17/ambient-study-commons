{
  "manifest_version": 3,
  "name": "Ambient Study Commons (Demo)",
  "version": "1.0.0",
  "description": "Zero-backend ambient study commons, learning journals, and peer matching demo.",
  "permissions": [
    "storage",
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Ambient Study Commons (Demo)",
    "default_icon": {
      "16": "assets/mascot/icon16.png",
      "32": "assets/mascot/icon32.png",
      "48": "assets/mascot/icon48.png",
      "128": "assets/mascot/icon128.png"
    }
  },
  "icons": {
    "16": "assets/mascot/icon16.png",
    "32": "assets/mascot/icon32.png",
    "48": "assets/mascot/icon48.png",
    "128": "assets/mascot/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "local_store.js",
        "ui/icons.js",
        "ui/toast.js",
        "ui/injector.js",
        "ui/draggable.js",
        "ui/paste_modal.js",
        "ui/dropdown_menu.js",
        "ui/master_button.js",
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "dashboard/*",
        "prompt/*",
        "assets/*",
        "mockserver/*"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
